        events[1] =
            FrozenEvent(PaymentReceiverV1.ReceiverNoteUpdated.selector, "ReceiverNoteUpdated(bytes32,bytes32)", 0);
        events[2] = FrozenEvent(
            PaymentReceiverV1.PaymentRouted.selector,
            "PaymentRouted(bytes32,bytes32,address,uint256,uint256,uint256)",
            3
        );
        events[3] = FrozenEvent(
            PaymentReceiverV1.UnsupportedTokenRecovered.selector,
            "UnsupportedTokenRecovered(address,address,uint256)",
            2
        );
        events[4] = FrozenEvent(PaymentReceiverV1.ForcedEthRecovered.selector, "ForcedEthRecovered(address,uint256)", 1);
        events[5] = FrozenEvent(Initializable.Initialized.selector, "Initialized(uint64)", 0);
    }
}
