{
  "name": "autolaunch-web-assets",
  "private": true,
  "type": "module",
  "scripts": {
    "assets:build": "mix assets.build",
    "typecheck": "tsc --project assets/tsconfig.json --noEmit && tsc --project test/browser/tsconfig.json --noEmit && tsc --project test/journeys/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:browser": "sh test/browser/walk.sh",
    "stills:home": "node assets/js/home_cells/stills.mjs"
  },
  "dependencies": {
    "@privy-io/react-auth": "3.51.1",
    "@solana-program/system": "0.16.0",
    "@solana-program/token": "0.18.0",
    "@solana/kit": "8.6.0",
    "animejs": "4.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vgpu": "0.6.0",
    "viem": "2.57.16",
    "@vgpu/wgsl": "0.6.0"
  },
  "overrides": {
    "ws@^8.0.0": "8.22.1",
    "axios": "1.21.0",
    "decode-uri-component": "0.5.1",
    "uuid": "14.0.3",
    "@modelcontextprotocol/server": "2.4.0",
    "@modelcontextprotocol/core": "2.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "@webgpu/types": "0.1.74"
  }
