*
!platform/assets/**
!platform/config/**
!platform/contracts/**
!platform/deps/**
!platform/lib/**
!platform/priv/**
!platform/rel/**
!platform/mix.exs
!platform/mix.lock
!platform/package.json
!platform/package-lock.json
# The RegentUI source enters as narrowly as the build uses it: the project file
# and modules Mix compiles, and the stylesheets platform/assets/css/app.css
# imports. Its own tests, lockfile, tooling files, digested priv/static output
# and JavaScript are not build inputs and stay out.
!design-system/regent_ui/mix.exs
!design-system/regent_ui/lib/**
!design-system/regent_ui/assets/css/**
!design-system/regent_ui/assets/js/**
!design-system/regent_ui/assets/images/**
!elixir-utils/privy/**
!mix-cache/**
!npm-cache/**
!esbuild-linux-arm64
!esbuild-linux-x64

# Dependencies enter as source. A dependency's priv carries compiler output,
# including extensionless host binaries. Two subtrees under it are shipped
# source rather than output: priv/static holds the JavaScript clients the
# asset build resolves through package main entries, and priv/templates is
# where Phoenix copies its generator templates during its own compile.
platform/deps/**/priv/**
!platform/deps/**/priv/static/**
!platform/deps/**/priv/templates/**

# The copied source trees must never carry runtime environment files.
**/.env
**/.env.*
**/.envrc

!regents/
!regents/identity/
!regents/identity/**
regents/identity/**/.env*
regents/identity/**/_build/
regents/identity/**/deps/
