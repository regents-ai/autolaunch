<Regent.Structure.frame class="shell">
  <a class="shell-skip" href="#shell-content">Skip to content</a>
  <Regent.Structure.row class="shell-body">
    <:rail_content>
      <.rail current_path={@current_path} />
    </:rail_content>
    <div class="shell-main">
      <.top_bar
        account_control={@account_control}
        credits={credits(assigns[:socket], assigns[:access_context], assigns[:credits_read])}
      />
      <.webmcp_tools />
      <%!-- While the phone menu is open the page and footer behind it are inert,
           which the browser sets (assets/js/shell_menu.ts) and LiveView keeps;
           the top bar stays usable, as in the template's shell. --%>
      <main
        id="shell-content"
        class="shell-content"
        tabindex="-1"
        data-shell-behind-menu
        phx-mounted={Phoenix.LiveView.JS.ignore_attributes(["inert"])}
      >
        <AutolaunchWeb.Components.LearnNavigation.navigation current_path={@current_path} />
        {@inner_content}
      </main>
      <.product_links
        id="shell-footer"
        data-shell-behind-menu
        phx-mounted={Phoenix.LiveView.JS.ignore_attributes(["inert"])}
      >
        <:phone>
          <AutolaunchWeb.Components.AgentTools.button
            id="shell-footer-agent-tools-button"
            dialog="shell-agent-tools"
          />
          <.theme_toggle id="theme-control-footer" />
        </:phone>
      </.product_links>
    </div>
  </Regent.Structure.row>
  <.drawer current_path={@current_path} />
  <Regent.Primitives.button
    variant="quiet"
    type="button"
    class="shell-menu-scrim"
    data-shell-menu-scrim
    aria-label="Close navigation"
    tabindex="-1"
  ></Regent.Primitives.button>
  <AutolaunchWeb.Components.SidePanel.panel
    account_control={@account_control}
    credits={credits(assigns[:socket], assigns[:access_context], assigns[:credits_read])}
  >
    <:pairing :if={pairing_account(assigns[:socket], assigns[:access_context])}>
      <.live_component
        module={AutolaunchWeb.PairingBox}
        id="shell-pairing-box"
        session_lease={@session_lease}
        account={pairing_account(@socket, @access_context)}
      />
    </:pairing>
  </AutolaunchWeb.Components.SidePanel.panel>
  <AutolaunchWeb.Components.Credits.dialog
    credits={credits(assigns[:socket], assigns[:access_context], assigns[:credits_read])}
    session_lease={assigns[:session_lease]}
  />
</Regent.Structure.frame>

{Phoenix.Component.live_render(assigns[:socket] || assigns[:conn], AutolaunchWeb.MarketTickerLive,
  id: "market-ticker"
)}
{Phoenix.Component.live_render(assigns[:socket] || assigns[:conn], AutolaunchWeb.SearchLive,
  id: "search"
)}
