<!DOCTYPE html>
<html
  lang="en"
  data-brand="autolaunch"
  data-theme="dark"
  data-prelaunch-read-only={to_string(Autolaunch.Prelaunch.read_only?())}
>
  <head>
    <meta charset="utf-8" />
    <link rel="alternate" type="text/plain" title="Agent guide" href={~p"/llms.txt"} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta name="privy-app-id" content={Autolaunch.Privy.app_id()} />
    <meta
      name="privy-bridge-src"
      content={AutolaunchWeb.Endpoint.static_path("/assets/js/privy_bridge.js")}
    />
    <.live_title default="Autolaunch">{assigns[:page_title]}</.live_title>
    <link rel="icon" type="image/svg+xml" href={~p"/favicon.svg"} />
    <link rel="icon" type="image/png" sizes="32x32" href={~p"/favicon-32.png"} />
    <link rel="apple-touch-icon" href={~p"/apple-touch-icon.png"} />
    <meta name="theme-color" content="#0e0e0e" />
    <script>
      ((query) => {
        const follow = () => {
          let saved
          if (location.pathname === "/blog" || location.pathname.startsWith("/blog/")) {
            try { saved = localStorage.getItem("autolaunch-blog-theme") } catch {}
          }
          document.documentElement.setAttribute("data-theme", ["light", "dark"].includes(saved) ? saved : (query.matches ? "light" : "dark"))
        }
        follow()
        query.addEventListener("change", follow)
      })(window.matchMedia("(prefers-color-scheme: light)"))
    </script>
    <link phx-track-static rel="stylesheet" href={~p"/assets/js/app.css"} />
    <script defer phx-track-static type="module" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body>
    <.lab_notice />
    {@inner_content}
  </body>
</html>
