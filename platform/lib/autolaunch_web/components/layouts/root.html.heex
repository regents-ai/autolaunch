<!DOCTYPE html> <% metadata =
  AutolaunchWeb.PublicDocuments.metadata(@conn.request_path, @page_title, @page_description) %>
<html
  lang="en"
  data-brand="autolaunch"
  data-theme={@theme}
  data-prelaunch-read-only={to_string(Autolaunch.Prelaunch.read_only?())}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content={@theme} />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta name="privy-app-id" content={Autolaunch.Privy.app_id()} />
    <meta
      name="privy-bridge-src"
      content={AutolaunchWeb.Endpoint.static_path("/assets/js/privy_bridge.js")}
    />
    <.live_title suffix={metadata.suffix}>{@page_title}</.live_title>
    <AutolaunchWeb.ShareCard.head
      share={assigns[:share]}
      title={metadata.title}
      description={metadata.description}
      path={@conn.request_path}
    />
    <link rel="icon" type="image/svg+xml" href={~p"/favicon.svg"} />
    <link rel="icon" type="image/png" sizes="32x32" href={~p"/favicon-32.png"} />
    <link rel="apple-touch-icon" href={~p"/apple-touch-icon.png"} />
    <meta name="theme-color" content={if @theme == "dark", do: "#0e0e0e", else: "#e5e3d2"} />
    <link phx-track-static rel="stylesheet" href={~p"/assets/js/app.css"} />
    <script defer phx-track-static type="module" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body>
    <.lab_notice />
    {@inner_content}
  </body>
</html>
