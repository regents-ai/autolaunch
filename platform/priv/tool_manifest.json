      "name": "autolaunch_bid_quote",
      "title": "Estimate a bid",
      "description": "Estimate an auction bid from stored public data. This does not prepare or submit a bid, open a wallet, or read the chain. Read all warnings, including auction_not_biddable.",
      "input_schema": {
        "type": "object",
        "properties": {
