        "readOnlyHint": true,
        "untrustedContentHint": true,
        "consequentialHint": false
      },
      "requires": "none",
      "state_changing": false,
      "payment": "none",
      "route": "POST /api/v1/auctions/{id}/bid-quote",
      "scope": "site"
