<!DOCTYPE html>
<html lang="en" data-brand="autolaunch" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="Autolaunch">{assigns[:page_title]}</.live_title>
    <script>
      ((query) => {
        const follow = () =>
          document.documentElement.setAttribute("data-theme", query.matches ? "light" : "dark")
        follow()
        query.addEventListener("change", follow)
      })(window.matchMedia("(prefers-color-scheme: light)"))
    </script>
    <link phx-track-static rel="stylesheet" href={~p"/assets/js/app.css"} />
    <script defer phx-track-static type="module" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body>
    {@inner_content}
  </body>
</html>
